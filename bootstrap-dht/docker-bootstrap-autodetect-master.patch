+// Auto-detect the default-route local address with zero traffic.
+// UDP connect() only sets the default remote; no packet is sent.
+// Throws boost::system::system_error on failure; caller converts to
+// "use explicit IP" error. Result must still pass is_valid_ep().
+address detect_default_route_address(bool v6)
+{
+	io_service ios;
+	udp::socket s(ios);
+	error_code ec;
+	if (!v6)
+	{
+		s.open(udp::v4(), ec);
+		if (ec) throw boost::system::system_error(ec);
+		s.connect(udp::endpoint(address::from_string("8.8.8.8"), 53), ec);
+		if (ec) throw boost::system::system_error(ec);
+		udp::endpoint local = s.local_endpoint(ec);
+		if (ec) throw boost::system::system_error(ec);
+		return local.address();
+	}
+	else
+	{
+		s.open(udp::v6(), ec);
+		if (ec) throw boost::system::system_error(ec);
+		s.connect(udp::endpoint(address::from_string("2001:4860:4860::8888"), 53), ec);
+		if (ec) throw boost::system::system_error(ec);
+		udp::endpoint local = s.local_endpoint(ec);
+		if (ec) throw boost::system::system_error(ec);
+		return local.address();
+	}
+}
